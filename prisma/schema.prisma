// Prisma Schema for AI-Native Collaborative Novel SaaS (novel-app)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String
  passwordHash  String
  avatarUrl     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  memberships   ProjectMember[]
  contributions ContributionEvent[]
  ideas         Idea[]              @relation("IdeaAuthor")
  comments      Comment[]
  notifications Notification[]
  activityLogs  ActivityLog[]
}

model Project {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  genre              String              @default("Fantasy")
  language           String              @default("English")
  targetWordCount    Int                 @default(80000)
  writingStyle       String?             @default("Third-Person Omniscient")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  members            ProjectMember[]
  chapters           Chapter[]
  contributionEvents ContributionEvent[]
  ideas              Idea[]
  characters         Character[]
  locations          Location[]
  worldbuilding      WorldBuildingEntry[]
  storyEvents        StoryEvent[]
  timelineEvents     TimelineEvent[]
  plots              Plot[]
  analyses           AIAnalysis[]
  activityLogs       ActivityLog[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("CO_AUTHOR") // OWNER, CO_AUTHOR, EDITOR, VIEWER
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Chapter {
  id            String              @id @default(cuid())
  projectId     String
  title         String
  orderIndex    Int                 @default(1)
  content       String              @default("")
  wordCount     Int                 @default(0)
  status        String              @default("DRAFT") // DRAFT, IN_PROGRESS, REVIEW, COMPLETED
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions      ChapterVersion[]
  contributions ContributionEvent[]
  comments      Comment[]
}

model ChapterVersion {
  id          String   @id @default(cuid())
  chapterId   String
  version     Int
  content     String
  wordCount   Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
}

model ContributionEvent {
  id             String   @id @default(cuid())
  userId         String
  projectId      String
  chapterId      String?
  type           String   @default("EDIT") // CREATE, INSERT, EDIT, DELETE, RESTRUCTURE, COMMENT, IDE_CREATE, IDE_DEVELOP
  beforeContent  String?
  afterContent   String?
  diff           String?
  wordDelta      Int      @default(0)
  characterDelta Int      @default(0)
  timestamp      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapter        Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
}

model Idea {
  id           String             @id @default(cuid())
  projectId    String
  authorId     String
  title        String
  description  String
  category     String             @default("PLOT") // PLOT, CHARACTER, WORLDBUILDING, CONFLICT, PLOT_TWIST, ENDING, THEME, OTHER
  status       String             @default("PROPOSED") // PROPOSED, IN_DEVELOPMENT, IMPLEMENTED, ARCHIVED
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User               @relation("IdeaAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  developments IdeaContribution[]
}

model IdeaContribution {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  type      String   @default("DEVELOPMENT") // DEVELOPMENT, IMPLEMENTATION
  notes     String?
  createdAt DateTime @default(now())

  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model Character {
  id               String                  @id @default(cuid())
  projectId        String
  name             String
  role             String                  @default("Protagonist") // Protagonist, Antagonist, Supporting
  status           String                  @default("ALIVE") // ALIVE, DEAD, MISSING, UNKNOWN
  description      String?
  personality      String?
  motivation       String?
  secrets          String?
  firstAppearance  String?
  lastAppearance   String?
  avatarUrl        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  relationshipsFrom CharacterRelationship[] @relation("RelFrom")
  relationshipsTo   CharacterRelationship[] @relation("RelTo")
}

model CharacterRelationship {
  id             String    @id @default(cuid())
  fromId         String
  toId           String
  type           String    @default("Ally") // Ally, Enemy, Family, Romantic, Secret
  description    String?

  fromCharacter  Character @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toCharacter    Character @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  type        String   @default("City")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WorldBuildingEntry {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  category    String   @default("Kingdoms") // Locations, Kingdoms, Organizations, Technology, Magic System, History, Culture, Religion, Other
  description String
  history     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model StoryEvent {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  chapterRef  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String
  timeString  String
  chapterRef  String?
  locationRef String?
  characters  String   @default("[]") // JSON string of involved character names or IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Plot {
  id          String      @id @default(cuid())
  projectId   String
  title       String
  type        String      @default("MAIN_PLOT") // MAIN_PLOT, SUBPLOT, CHARACTER_ARC
  status      String      @default("IN_PROGRESS")
  description String?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  points      PlotPoint[]
}

model PlotPoint {
  id          String   @id @default(cuid())
  plotId      String
  title       String
  description String?
  chapterRef  String?
  orderIndex  Int      @default(1)

  plot        Plot     @relation(fields: [plotId], references: [id], onDelete: Cascade)
}

model Comment {
  id           String   @id @default(cuid())
  chapterId    String
  userId       String
  content      String
  selectedText String?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  chapter      Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIAnalysis {
  id           String   @id @default(cuid())
  projectId    String
  analysisType String   // CONTRIBUTION, STORY_CONSISTENCY, TIMELINE, PLOT, CHARACTER, IDEA
  status       String   @default("COMPLETED")
  result       String   // JSON payload string
  confidence   Float    @default(0.95)
  createdAt    DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
